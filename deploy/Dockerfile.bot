# Construit depuis la racine du projet :
#   docker compose -f deploy/docker-compose.yml build bot
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.5.20 /uv /uvx /usr/local/bin/

WORKDIR /app
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never

# Dépendances d'abord : cache Docker, ne se réinstallent pas si seul le
# code du bot change ensuite.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY bot bot

# Le bot n'a aucun état à persister (pas de content/, pas de data/) :
# pas de volume, pas de dossier à préparer.
RUN useradd --create-home runner && chown -R runner:runner /app
USER runner

CMD ["uv", "run", "--frozen", "--no-dev", "python", "-m", "bot.main"]
