# Copier vers .env puis remplir.
# Les hashs et la clé se génèrent avec : python scripts/genere_hash.py

# Domaine pointant vers la Pi (port 80/443 ouverts sur la box)
DOMAINE=runs.example.org

# Hashs argon2 des phrases de passe
MDP_JOUEUSE_HASH=
MDP_MJ_HASH=

# Clé de signature des sessions (64 caractères hexa)
CLE_SECRETE=

# Cookies Secure : toujours 1 derrière HTTPS
SECURE_COOKIES=1
