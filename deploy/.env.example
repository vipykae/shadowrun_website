# Copier vers .env puis remplir.
# Les hashs et les jetons se génèrent avec : python scripts/genere_hash.py

# Domaine pointant vers le serveur (port 80/443 ouverts)
DOMAINE=runs.example.org

# Hashs argon2 des phrases de passe
MDP_JOUEUSE_HASH=
MDP_MJ_HASH=

# Clé de signature des sessions (64 caractères hexa)
CLE_SECRETE=

# Cookies Secure : toujours 1 derrière HTTPS
SECURE_COOKIES=1

# Export calendrier .ics (optionnel) : jeton indépendant du login (les
# applis calendrier ne savent pas se connecter avec un mot de passe).
# Vide = /api/calendrier.ics renvoie 503.
CALENDRIER_TOKEN=

# Bot Discord (voir bot/README.md) : modération (/purge_between), jets de dés
# (/roll), et notifications (nouvelle run, inscription, run jouée — remplace
# l'ancien DISCORD_WEBHOOK_URL, qui n'existe plus). Token depuis Discord
# Developer Portal > ton appli > Bot. Vide = bot ET notifications désactivés,
# le site continue de fonctionner seul.
DISCORD_BOT_TOKEN=

# ID du salon où poster les notifications (clic droit sur le salon > Copier
# l'ID, mode développeur requis). Vide = bot actif (commandes slash) mais
# notifications désactivées.
DISCORD_NOTIFY_CHANNEL_ID=

# Laisser VIDE en prod : synchronise les commandes slash globalement sur tous
# les serveurs où le bot est invité (jusqu'à 1h de propagation). Ne renseigner
# que pour du test sur un serveur perso (synchro instantanée, mais uniquement
# sur ce serveur-là) — voir bot/.env.example.
DISCORD_TEST_GUILD_ID=
