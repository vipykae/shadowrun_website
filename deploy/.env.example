# Copier vers .env puis remplir.
# Les hashs et les jetons se génèrent avec : python scripts/genere_hash.py

# Domaine pointant vers le serveur (port 80/443 ouverts)
DOMAINE=runs.example.org

# Hashs argon2 des phrases de passe
MDP_JOUEUSE_HASH=
MDP_MJ_HASH=

# Clé de signature des sessions (64 caractères hexa)
CLE_SECRETE=

# Cookies Secure : toujours 1 derrière HTTPS
SECURE_COOKIES=1

# Export calendrier .ics (optionnel) : jeton indépendant du login (les
# applis calendrier ne savent pas se connecter avec un mot de passe).
# Vide = /api/calendrier.ics renvoie 503.
CALENDRIER_TOKEN=

# Adresse publique du site, pour les liens vers les runs dans les messages
# Discord (ex. https://runs.example.org). Optionnel : à défaut, le bot
# utilise https://DOMAINE.
URL_SITE=

# Bot Discord (voir bot/README.md) : modération (/purge_between), jets de dés
# (/roll), et annonces des runs (un post de forum par run). Token depuis
# Discord Developer Portal > ton appli > Bot. Vide = bot ET annonces
# désactivés, le site continue de fonctionner seul.
DISCORD_BOT_TOKEN=

# ID du salon FORUM des runs : le bot y crée un post par run publiée, puis y
# signale chaque changement (inscriptions, date, modifications) et y poste le
# compte rendu une fois la run jouée. Clic droit sur le salon > Copier l'ID
# (mode développeur requis). Vide = bot actif (commandes slash) mais runs non
# annoncées. Remplace l'ancien DISCORD_NOTIFY_CHANNEL_ID.
DISCORD_FORUM_RUNS_ID=

# ID du salon textuel « flash news » : la flash news d'une run y est postée
# quand elle passe en jouée. Vide = flash news non publiées.
DISCORD_FLASH_NEWS_CHANNEL_ID=

# Laisser VIDE en prod : synchronise les commandes slash globalement sur tous
# les serveurs où le bot est invité (jusqu'à 1h de propagation). Ne renseigner
# que pour du test sur un serveur perso (synchro instantanée, mais uniquement
# sur ce serveur-là) — voir bot/.env.example.
DISCORD_TEST_GUILD_ID=
