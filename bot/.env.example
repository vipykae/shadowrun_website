# Copier vers bot/.env puis remplir.

# Token du bot, depuis https://discord.com/developers/applications
# > ton appli > Bot > Reset Token
DISCORD_BOT_TOKEN=

# ID de ton serveur Discord perso, pour tester les commandes slash instantanément
# (sans ça, la synchro est globale et peut prendre jusqu'à 1h à apparaître).
# Clic droit sur le serveur dans Discord > Copier l'ID (mode développeur requis :
# Réglages > Avancés > Mode développeur).
DISCORD_TEST_GUILD_ID=
